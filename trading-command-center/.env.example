# Trading Command Center - konfigurasi
# Salin ke .env. Semua variabel opsional; nilai di bawah adalah default.
#
# Semua sumber data GRATIS, tanpa API key dan tanpa langganan:
#   - Yahoo Finance      : harga & candle saham IDX/AS/kripto, fundamental, berita global
#   - CoinGecko          : cadangan harga kripto bila Yahoo gagal
#   - Forex Factory      : kalender ekonomi mingguan
#   - Google News RSS    : berita saham IDX & IHSG

# ---------------------------------------------------------------------------
# Keamanan (WAJIB untuk Docker / ENVIRONMENT=production)
# ---------------------------------------------------------------------------
APP_PASSWORD=               # password login dashboard; kosong = mode lokal tanpa login
SECRET_KEY=                 # opsional: string acak panjang, menambah kekuatan tanda tangan token
CORS_ORIGINS=["http://localhost","http://localhost:3000"]

# ---------------------------------------------------------------------------
# LLM lokal opsional untuk narasi fitur Generate (gratis, offline)
#   1. Pasang Ollama: https://ollama.com   2. ollama pull llama3.1:8b
#   Docker: OLLAMA_URL=http://host.docker.internal:11434  | manual: http://localhost:11434
# Kosong = narasi template (fitur tetap berjalan penuh).
# ---------------------------------------------------------------------------
OLLAMA_URL=
OLLAMA_MODEL=llama3.1:8b

# ---------------------------------------------------------------------------
# Notifikasi (opsional, gratis). Kosongkan bila tidak dipakai.
# ---------------------------------------------------------------------------
# Buat bot di Telegram lewat @BotFather; chat id bisa dilihat lewat @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Server Settings > Integrations > Webhooks di Discord
DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Database (SQLite gratis, folder dibuat otomatis)
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///data/trading.db

# ---------------------------------------------------------------------------
# Paper trading
# ---------------------------------------------------------------------------
INITIAL_CAPITAL=100000000   # modal awal (IDR)
BUY_FEE=0.0015              # 0.15%
SELL_FEE=0.0025             # 0.25% (termasuk PPh final 0.1%)
MAX_POSITIONS=10
RISK_PER_TRADE=0.02

# ---------------------------------------------------------------------------
# Sinyal & data
# ---------------------------------------------------------------------------
MIN_CONFIDENCE_SCORE=70     # ambang awal; AI Brain menyesuaikan per strategi
SIGNAL_EXPIRY_HOURS=24
UPDATE_INTERVAL=60          # detik (minimum efektif 60)

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false                 # true menampilkan detail error ke klien (hanya untuk pengembangan)
HOST=127.0.0.1              # Docker tetap memakai 0.0.0.0 (lihat Dockerfile.backend)
PORT=8000
