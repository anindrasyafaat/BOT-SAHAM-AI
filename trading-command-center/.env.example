# Trading Command Center - Environment Configuration
# Copy this file to .env and fill with your API keys

# =============================================================================
# API KEYS - GET THESE FROM PROVIDERS
# =============================================================================

# Alpha Vantage - FOR US STOCK DATA
# Get free API key from: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Finnhub - FOR REAL-TIME STOCK DATA
# Get free API key from: https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_api_key_here

# News API - FOR MARKET NEWS & SENTIMENT
# Get free API key from: https://newsapi.org/
NEWS_API_KEY=your_news_api_key_here

# Telegram Bot - FOR NOTIFICATIONS (Optional)
# Create bot with @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Discord Webhook - FOR NOTIFICATIONS (Optional)
# Create webhook in Discord server settings
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# =============================================================================
# DATABASE & CACHE CONFIGURATION
# =============================================================================

# Database Configuration
DATABASE_URL=sqlite:///data/trading.db

# Redis Configuration (For caching and real-time data)
REDIS_URL=redis://localhost:6379
REDIS_TTL=300  # Cache TTL in seconds (5 minutes)

# =============================================================================
# TRADING PARAMETERS
# =============================================================================

# Risk Management
MAX_POSITIONS=10                 # Maximum open positions
RISK_PER_TRADE=0.02             # Risk per trade (2%)
MAX_DAILY_LOSS=0.05             # Maximum daily loss (5%)
STOP_LOSS_MULTIPLIER=2.0        # Stop loss multiplier

# Signal Generation
MIN_CONFIDENCE_SCORE=70         # Minimum confidence for signals (70%)
SIGNAL_EXPIRY_HOURS=24          # Signal expiry time in hours

# =============================================================================
# MARKET DATA CONFIGURATION
# =============================================================================

# Update Intervals
UPDATE_INTERVAL=10              # Market data update interval in seconds
WEBSOCKET_RECONNECT_INTERVAL=5  # WebSocket reconnect interval in seconds

# Supported Markets (Don't change unless you know what you're doing)
PAPER_TRADING_ENABLED=true      # Enable paper trading mode

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Environment
ENVIRONMENT=development         # development/production
DEBUG=true                      # Enable debug mode
HOST=0.0.0.0                    # Server host
PORT=8000                       # Server port

# =============================================================================
# OPTIONAL ADVANCED SETTINGS
# =============================================================================

# Market Data Providers
ENABLE_YFINANCE=true            # Enable Yahoo Finance data
ENABLE_FINNHUB=true             # Enable Finnhub data
ENABLE_INVESTPY=true            # Enable Investpy data (Indonesia stocks)
ENABLE_CCXT=true                # Enable CCXT for crypto data

# Strategy Configuration
ENABLE_EMA_STRATEGY=true
ENABLE_SUPERTREND_STRATEGY=true
ENABLE_BOLLINGER_STRATEGY=true
ENABLE_VWAP_STRATEGY=true
ENABLE_BREAKOUT_STRATEGY=true
ENABLE_MEAN_REVERSION_STRATEGY=true
ENABLE_LIQUIDITY_SWEEP_STRATEGY=true
ENABLE_GOLDEN_CROSS_STRATEGY=true
ENABLE_HEIKIN_ASHI_STRATEGY=true
ENABLE_ML_ENSEMBLE_STRATEGY=true

# Notification Settings
ENABLE_TELEGRAM_NOTIFICATIONS=false
ENABLE_DISCORD_NOTIFICATIONS=false
ENABLE_BROWSER_NOTIFICATIONS=true
ENABLE_SOUND_ALERTS=true

# Logging
LOG_LEVEL=INFO                  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_TO_FILE=true                # Enable file logging
LOG_TO_CONSOLE=true             # Enable console logging